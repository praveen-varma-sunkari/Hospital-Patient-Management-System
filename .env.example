# =====================================================================
# Bheeshma Healthcare — Hospital Patient Management System
# .env.example — Copy this file to .env and fill in values
# =====================================================================

# ── App Identity ──────────────────────────────────────────────────
VITE_APP_NAME=Bheeshma Healthcare
VITE_APP_VERSION=2.4.0
VITE_APP_ENV=production
VITE_APP_DESCRIPTION=Enterprise Triage and Queue Management System

# ── Hospital Info ─────────────────────────────────────────────────
VITE_HOSPITAL_NAME=Bheeshma Multi-Specialty Hospital
VITE_HOSPITAL_PHONE=+91-040-12345678
VITE_HOSPITAL_EMAIL=admin@bheeshma.health
VITE_HOSPITAL_ADDRESS=Hyderabad, Telangana, India - 500001

# ── System Limits ─────────────────────────────────────────────────
VITE_TOTAL_ICU_BEDS=20
VITE_MAX_PATIENTS_PER_QUEUE=100
VITE_SESSION_TIMEOUT_MINUTES=60

# ── Feature Flags ─────────────────────────────────────────────────
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_CSV_EXPORT=true
VITE_ENABLE_BINARY_SEARCH_VISUALIZER=true
VITE_ENABLE_WARD_FLOOR_PLAN=true
VITE_ENABLE_CPP_DSA_MODAL=true

# ── Default Theme ─────────────────────────────────────────────────
VITE_DEFAULT_THEME=dark
